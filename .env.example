# Required to actually call Claude. Without this, the agent's deterministic
# parts (tools, sandboxing, graph control flow) still work and are covered by
# the test suite, but `run.py` can't make real planning/editing decisions.
ANTHROPIC_API_KEY=

# Only required if you pass --issue-number to fetch a real GitHub issue, or
# --allow-pr to actually open a pull request. Needs `repo` scope.
GITHUB_TOKEN=
